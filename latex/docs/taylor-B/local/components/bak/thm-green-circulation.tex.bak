% \input{\pGlobalThms/"thm-green-circulation"}
\typeout{ \enumElements \pGlobalThms/"thm-green-circulation"}

\begin{theorem}[Green's Theorem I: Circulation Form]
    Let $C$ be a positively oriented, piecewise-smooth simple closed curve in the plane, and let $D$ be the region bounded by $C$. If $P(x, y)$ and $Q(x, y)$ have continuous partial derivatives on an open region containing $D$, then:
\begin{equation}
	\oint_C \paren{ P \, dx + Q \, dy } = \iint_D \paren{ \frac{\partial Q}{\partial x} - \frac{\partial P}{\partial y} } \, dA
\label{eq:green-circulation}
\end{equation}
\end{theorem}

