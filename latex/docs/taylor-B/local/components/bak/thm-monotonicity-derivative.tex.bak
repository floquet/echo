% \input{\pLocalTheorems "thm-monotonicity-derivative"}

\begin{theorem}[Monotonic Behavior of the Derivative]
Given two nonzero vectors $t^{b}\in\cmplx{m}$ and $R\in\cmplx{m}$, the following scalar relationship is true
		%
\begin{equation}
	D_{b} \phi_{\star}(b) 
	\begin{cases}
		< 0 & -\infty < b < b_{LS} \\
		= 0 & b = b_{LS} \\
		> 0 & b_{LS} < b < \infty
	\end{cases}
\label{eq:monotonic}
\end{equation}
		%
\label{thm:monotonicity}
\end{theorem}
