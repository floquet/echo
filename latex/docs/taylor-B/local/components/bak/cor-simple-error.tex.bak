% \input{\pThms/"cor-simple-error.tex"}
\typeout{ \enumContent \pThms/"cor-simple-error.tex"}
%
%\clearpage
\begin{corollary}[Error for the Original Model]

Given least squares problem and solution in theorem \ref{eq:merit-simple}, the corresponding error is
		%
\begin{equation}
	\sigma_{a} = \sqrt{ \frac{\innerSelf{u} - \inner{u}{v} - \inner{v}{u}} {\paren{m-1}\innerSelf{u}} }
\label{eq:cor-stmt:simple}
\end{equation}
		%
\label{cor:simple-error}
\end{corollary}
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
   
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
\begin{proof}
The specific template for the least squares error in $\mu$ is
		%
\begin{equation}
	\sigma_{a} = \sqrt{ \frac{\phi^{2}\paren{a_{p}}} {m-1} \innerSelf{\Upsilon}}
\tag{\ref{eq:error-template}}
\end{equation}
where the vector $\Upsilon$ encodes the derivatives of the solution with respect to each datum:
		%
\begin{equation}
	\Upsilon_{k} = \frac{d}{d_{v_{k}}} \inner{u}{v} =u_{k},
\label{eq:deriv}
\end{equation}
		%
showing that $\Upsilon = \innerSelf{u}^{-1} u$.The salient relationship is $\frac{d}{d_{z_{k}}} \inner{\one}{z} = 1$ which implies the vector $\Upsilon = \innerSelf{\one}^{-1}\one$ with norm
		%
%\begin{equation*}
%	\frac{d}{d_{z_{k}}} \inner{\one}{z} = 1
%%\label{eq:}
%\end{equation*}
%		%
%		%
%\begin{equation*}
%	\Upsilon = \innerSelf{\one}^{-1}\one
%%\label{eq:}
%\end{equation*}
		%
		%
\begin{equation*}
	\innerSelf{\Upsilon} = \innerSelf{\one}^{-1}.
%\label{eq:}
\end{equation*}
		%
Direct substitution of the least squares solution \eqref{eq:thm:mean:soln} into the definition for $\phi^{2}(\mu)$ in \eqref{eq:pf-phi} provides
		%
\begin{equation*}
	\phi^{2}\paren{\mu_{p}} = \innerSelf{z}- \frac{\inner{\one}{z}\inner{z}{\one}} {\innerSelf{\one}},
%\label{eq:}
\end{equation*}
		%
by now a familiar form, and the solution becomes
		%
\begin{equation}
	\sigma_{\mu} = \sqrt{ \frac{\overline{z^{*}z} - \overline{z^{*}} \overline{z} }{m-1}}.
\label{eq:cor-prf-alpha}
\end{equation}
\end{proof}
