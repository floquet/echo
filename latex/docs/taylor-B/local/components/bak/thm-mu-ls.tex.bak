%
%\clearpage
\subsection{The Mean as Least Squares}
\begin{theorem}[The Mean as Least Squares]

Given a vector $v\icm$, and a prophetically-named constant $\alpha\in\cmplx{}$, pose the model equation
\begin{equation}
	\alpha \one = v
%\tag{\ref{eq:coalesce}}
\label{eq:mean-lsf}
\end{equation}
where $\one$ is the constant vector of length $m$. The least squares solution for this model,
\begin{equation}
		%
	\alpha = \frac{\itwo{\one}{v}}{\innerSelf{\one}} = \mu_{v},
		%
\label{eq:thm:mean:soln}
\end{equation}
is the arithmetic mean of the vector $v$.
%
\label{thm:mean-ls}
\end{theorem}
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
   
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
\begin{proof}
	Define the minimization target function, the length of the residual error vector, as
		%
\begin{equation}
	\phi^{2}(\alpha) = \normts{\alpha \one - v} = \innerSelf{v} + \alpha^{*}\alpha\innerSelf{\one} - \alpha\itwo{v}{\one} - \alpha^{*}\itwo{\one}{v} 
\label{eq:pf-phi}
\end{equation}
		%
The least squares solution is the point $\alpha$ which satisfies
		%
\begin{equation}
	\frac{d}{d \alpha} \phi^{2}(\alpha) = 0.
%\label{eq:}
\end{equation}
		%
	The condition becomes 
		%
\begin{equation}
	\alpha^{*}\innerSelf{\one} - \itwo{v}{\one} = 0.
%\label{eq:}
\end{equation}
		%
Solving for $\alpha^{*}$ and taking the complex conjugate of both sides of this equation reduces to \eqref{eq:thm:mean:soln}. (Recognize this theorem as a special case of \ref{thm:simple} with  $u = \one$.)
\end{proof}
%
