%\clearpage
\subsection{The Mean as Least Squares}
\begin{theorem}[The Mean as Least Squares]

Given a vector $z\icm$, and a constant $a_{0}\in\cmplx{}$, pose the model equation
\begin{equation}
	z = a_{0} \one
%\tag{\ref{eq:coalesce}}
\label{eq:mean-lsf}
\end{equation}
where $\one$ is the constant vector of length $m$. 

The least squares solution for this model is
\begin{equation}
		%
	\paren{a_{0}}_{p} = \frac{\itwo{\one}{z}}{\innerSelf{\one}}.
		%
\label{eq:thm:mean:soln}
\end{equation}
%
\label{thm:mean-ls}
\end{theorem}
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
   
   %%%   %%%   %%%   %%%   %%%   %%%   %%%   %%%
\begin{proof}
	Define the minimization target function, the length of the residual error vector, as
		%
\begin{equation}
	\phi^{2}(a_{0}) = \normts{z - a_{0} \one} = \innerSelf{z} + a_{0}^{*}a_{0}\innerSelf{\one} - a_{0}\itwo{z}{\one} - a_{0}^{*}\itwo{\one}{z} 
\label{eq:pf-phi}
\end{equation}
		%
The least squares solution is the point $a_{0}$ which satisfies
		%
\begin{equation}
	\frac{d}{d a_{0}} \phi^{2}(a_{0}) = 0.
%\label{eq:}
\end{equation}
		%
	The condition becomes 
		%
\begin{equation}
	a_{0}^{*}\innerSelf{\one} - \itwo{z}{\one} = 0.
%\label{eq:}
\end{equation}
		%
Taking the complex conjugate of both sides of this equation reduces \eqref{eq:thm:mean:soln}.
\end{proof}
%
