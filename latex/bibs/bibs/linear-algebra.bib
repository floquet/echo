	journal = {SIAM Review},
	number = {1},
	pages = {3-49},
	title = {Nineteen Dubious Ways to Compute the Exponential of a Matrix, Twenty-Five Years Later},
	url = {https://doi.org/10.1137/S00361445024180},
	volume = {45},
	year = {2003},
