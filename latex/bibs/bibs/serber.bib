@techreport{thompson2021radiation,
	abstract = {Starting in 2019, the Lagrangian Applications Project (LAP) and the Transport Project set out to develop a new ALE/Lagrangian radiation-hydrodynamics (RH) capability in a new code product named LUMOS. This work was done under the guidance of the Advanced Simulation and Computing (ASC) program with the goal of producing software capable of leveraging the high-order thermal radiative transfer (TRT) solvers provided by the Jayenne and Capsaicin software projects. This capability supplements the existing gray diffusion solver that is currently available in LAP's FLAG code [1, 2, 3] for RH. The remainder of this memo describes the coupling of the radiation and hydrodynamics solvers within LAP's LUMOS code. Initially delivered in 2020 as part of an L2 milestone [4], this capability continues to mature in FY21 with more efficient and robust algorithms, new support for ALE, and support for mixed materials per cell. Today, LUMOS is provided as a standard end-user product in the suite of LAP tools provided in each release cycle. Code access can be requested at https://asc.lanl.gov.},
	author = {Thompson, Kelly Glen and Wollaeger, Ryan Thomas and Budge, Kent Grimmett},
	date-added = {2025-10-05 13:19:15 -0600},
	date-modified = {2025-10-05 13:19:39 -0600},
	institution = {Los Alamos National Laboratory (LANL), Los Alamos, NM (United States)},
	title = {Radiation Hydrodynamics in the Lagrangian Application Project's LUMOS code},
	url = {https://www.osti.gov/biblio/1819126},
	year = {2021}}

@techreport{andrews2020verification,
	abstract = {Advanced reactive burn models enable phenomena to be modeled that aren't possible with programmed burn. Programmed burn propagates a burn front at a prescribed speed from a prescribed initiation point. Reactive burn uses the hydro variables (pressure, temperature, etc.) to determine when, how rapidly, and to what extent a zone detonates. This enables a completely new set of problems to be simulated. Our goal in this milestone has been to improve the usability of reactive burn modes. Thus, the closure criteria are: 1. Perform code and solution verification of the reactive burn models using appropriate solutions and simplified HE setups. 2. Perform validation assessments using small-scale experiments. 3. Evaluate sensitivities and quantify uncertainties due to model form variations and mesh dependencies.},
	author = {Andrews, Stephen Arthur and Aslam, Tariq Dennis and Coleman, Adam Carrigan and Ferguson, Jim Michael and Gibbs, John W and Grove, John W and Hickmann, Kyle Scott and Holland, Troy Michael and Koskelo, Aaron C and Menikoff, Ralph and others},
	date-added = {2025-10-05 13:12:28 -0600},
	date-modified = {2025-10-05 13:13:03 -0600},
	institution = {Los Alamos National Laboratory (LANL), Los Alamos, NM (United States)},
	title = {Verification and Validation of High Explosive Reactive Burn Models Implemented in LANL's EAP and LAP Code Base (FY2020 L2 Milestone MRT 7129)[Slides]},
	url = {https://www.osti.gov/biblio/1699446},
	year = {2020}}

