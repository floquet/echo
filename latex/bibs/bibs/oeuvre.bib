@techreport{TopaLearningCurve,
	abstract = {Linear regression is the wrong technique to use to fit learning curve data. The prerequisite logarithmic transformation destroys the residuals that a least squares fit is purported to minimize. Furthermore, this transformation takes the data into a space without a metric where it is impossible to formulate any residuals. The good news is that a bona fide least squares fit to the data is direct and simple---it reduces to a trivial minimization of a one-dimensional function with a lone minimum. The correct method also allows for additional fitting criteria such as forcing the data through a specified point or to a specified sum. We then show how a differential error analysis would have signaled the impropriety of the linear regression. We close with a discussion of simple symmetry considerations that can identify faulty algorithms and incorrect computer codes.},
	address = {P.O. Box 8381, Albuquerque, NM 87198-8381},
	author = {Daniel M. Topa},
	date-added = {2025-09-05 18:18:27 -0600},
	date-modified = {2025-09-05 19:38:39 -0600},
	institution = {University of New Mexico},
	title = {A Closer Look at the Learning Curve},
	type = {Technical Report},
	year = {Unpublished}}

@techreport{Topa2010Lenslet,
	abstract = {A significant part of the computations with a Shack-Hartmann wavefront sensor is in the focal spot local algorithms. Typically, a center of mass algorithm is used. Typically such calculations have three significant digits. We use a center of mass technique here to do a precision measurement of the size and location of the lenslet array. While the errors in the center of mass algorithm can be shown to be systematic, their manifestation in most physical measurements appears, to first order, stochastic. This paper outlines a least squares technique which largely compensates for the stochastic errors and produces a result with five significant figures. This represents a precision improvement of three orders of magnitude.},
	address = {14810 Central Ave. SE, Albuquerque, NM 87123-3905},
	author = {Daniel M. Topa},
	date-added = {2025-09-05 17:56:41 -0600},
	date-modified = {2025-09-05 17:56:41 -0600},
	institution = {WaveFront Sciences, Inc.},
	note = {Unpublished internal report},
	title = {Precision Measurements of a Lenslet Array},
	type = {Technical Report},
	url = {mailto:dtopa@wavefrontsciences.com},
	year = {2010},
	bdsk-url-1 = {mailto:dtopa@wavefrontsciences.com}}

