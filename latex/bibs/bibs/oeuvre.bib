@techreport{topa2016triangulation,
	abstract = {Triangulation is one of mankind's oldest problems in applied mathematics; the method of least squares is one of the most fundamental tools in applied mathematics. We survey and update least squares methods for the triangulation problem and explore tidbits such as ghost solutions and the uncustomary appearance of the residuals. Ghost solutions have null space components which render them aphysical. Examples of dense and non-dense sets of ghost solutions are provided. Invariance tests reveal how to diagnose rank deficient problems.},
	address = {Vicksburg, MS},
	author = {Topa, Daniel},
	date-added = {2025-09-15 22:28:00 -0600},
	date-modified = {2025-09-15 22:28:00 -0600},
	institution = {High Performance Computing Modernization Program, DoD Supercomputing Resource Center, Engineer Research and Development Center},
	title = {Linear Least Squares, Triangulation with Direction in Euclidean Space, Invariances and Ghost Solutions},
	type = {Technical Report},
	year = {2016}}

@techreport{topa2016artificial,
	abstract = {A popular misconception about numerical solutions of partial differential equations is that smaller time steps produce better solutions; shrinking the time step can completely dissipate the propagating wave. The archetypical case is the advection equation solved below using a Lax scheme. The averaging in the spatial derivative introduces artificial viscosity; as the time step shrinks this viscosity damps out the solution. A demonstration follows.},
	address = {Vicksburg, MS},
	author = {Topa, Daniel},
	date-added = {2025-09-15 22:04:39 -0600},
	date-modified = {2025-09-15 22:04:39 -0600},
	day = {22},
	institution = {High Performance Computing Modernization Program, DoD Supercomputing Resource Center, Engineer Research and Development Center},
	month = {September},
	title = {Artificial Viscosity},
	type = {Technical Report},
	year = {2016}}

@techreport{Topa2001Stitching,
	abstract = {We discuss how to take data from many camera frames and piece them together to form a larger picture. The nature of the problem is that as the translation stage moves, it introduces varying amounts of tilt. To stitch the images together into a quilt this unknown tilt must be removed. In this model, the camera frames all overlap, so some regions are imaged twice. The average of the slopes in these overlap regions reveals the relative tilt difference between adjacent frames. The least squares fit adjusts the overall tilt for every frame to best describe the data set. The analysis here assumes a perfect reference file.},
	address = {14810 Central Ave SE, Albuquerque, NM 87123},
	author = {Daniel M. Topa},
	date-added = {2025-09-05 19:31:01 -0600},
	date-modified = {2025-09-05 19:33:26 -0600},
	institution = {WaveFront Sciences, Inc.},
	title = {Stitching Multiple Camera Frames into a Single Picture},
	type = {Technical Report},
	year = {2001}}

