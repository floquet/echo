@article{vinti1959new,
	abstract = {An axially symmetric solution of Laplace's equation in oblate spheroidal coordinates is found, which may be used as the gravitational potential about an oblate planet. This potential, which makes the Hamilton-Jacobi equation for a satellite orbit separable, has an expansion in zonal harmonics in which the amplitudes of the zeroth and second harmonics can be adjusted to agree exactly with the values for any axially symmetric planet and a fourth harmonic which then agrees approximately with the latest value for that of the earth. The net result is therefore a reduction of the problem of satellite motion to quadratures, with use of a potential field that is much closer to the empirically accepted one for the earth than any heretofore used as the starting point of a calculation. It may thus be possible to do the gravitational theory of a satellite orbit very accurately without use of perturbation theory. The method can take into account a first harmonic in the potential, in case observations are reduced to a center which does not coincide with the center of mass of the planet. },
	author = {Vinti, John P},
	date-added = {2025-04-17 18:36:21 -0600},
	date-modified = {2025-04-17 18:36:21 -0600},
	journal = {Journal of Research of the National Bureau of Standards: Mathematics and mathematical physics. B},
	pages = {105},
	publisher = {The Bureau},
	title = {New Method of Solution for Unretarded Satellite Orbits$^1$},
	url = {https://nvlpubs.nist.gov/nistpubs/jres/63B/jresv63Bn2p105_A1b.pdf},
	volume = {63},
	year = {1959},
	bdsk-url-1 = {https://nvlpubs.nist.gov/nistpubs/jres/63B/jresv63Bn2p105_A1b.pdf}}

@article{amato2019non,
	abstract = {This paper is concerned with the comparison of semi-analytical and non-averaged propagation
methods for Earth satellite orbits. We analyse the total integration error for semi-analytical methods and
propose a novel decomposition into dynamical, model truncation, short-periodic, and numerical error components. The first three are attributable to distinct approximations required by the method of averaging,
which fundamentally limit the attainable accuracy. In contrast, numerical error, the only component present
in non-averaged methods, can be significantly mitigated by employing adaptive numerical algorithms and
regularized formulations of the equations of motion. We present a collection of non-averaged methods based
on the integration of existing regularized formulations of the equations of motion through an adaptive solver.
We implemented the collection in the orbit propagation code THALASSA, which we make publicly available,
and we compared the non-averaged methods to the semi-analytical method implemented in the orbit propagation tool STELA through numerical tests involving long-term propagations (on the order of decades) of
LEO, GTO, and high-altitude HEO orbits. For the test cases considered, regularized non-averaged methods
were found to be up to two times slower than semi-analytical for the LEO orbit, to have comparable speed
for the GTO, and to be ten times as fast for the HEO (for the same accuracy). We show for the first time
that efficient implementations of non-averaged regularized formulations of the equations of motion, and especially of non-singular element methods, are attractive candidates for the long-term study of high-altitude
and highly elliptical Earth satellite orbits.},
	author = {Amato, Davide and Bombardelli, Claudio and Ba{\`u}, Giulio and Morand, Vincent and Rosengren, Aaron J},
	date-added = {2025-04-17 18:36:21 -0600},
	date-modified = {2025-04-17 18:36:21 -0600},
	journal = {Celestial Mechanics and Dynamical Astronomy},
	pages = {1--38},
	publisher = {Springer},
	title = {Non-averaged regularized formulations as an alternative to semi-analytical orbit propagation methods},
	volume = {131},
	year = {2019}}

@inproceedings{10333817,
	abstract = {CubeSats represent a low-cost tool for the study, interpretation, and design of satellite modules and their associated factors. Particularly for the attitude determination and control subsystem, the system's challenges lie in the high degree of nonlinearity in the satellite's dynamic model and the disturbances in the orbital environment. The kinetics contain second-order algebraic nonlinearities in terms of angular velocity; on the other hand, depending on the attitude coordinates used to describe the satellite's orientation, the kinematics can contain algebraic and/or trigonometric nonlinearities, leading to geometric singularities or indeterminacies. These issues present in the dynamic model (kinetic and kinematic) affect the development of controllers, as they complicate the implementation of control laws, limit the satellite's operating range, and require techniques for disturbance rejection.This research addresses the development of attitude control techniques for a CubeSat that account for the nonlinearities in the satellite's dynamic model and reject disturbances from the orbital environment in order to perform pointing maneuvers. In this scenario, the attitude control system is capable of performing solar pointing, nadir tracking, and active Earth tracking.Using the V-methodology, the mission design processes, subsystem requirements, design and implementation of orbital and satellite dynamics, and controllers are addressed, followed by the evaluation of the controllers and verification of compliance with requirements.As a result of the process, the implemented nonlinear controllers successfully perform pointing maneuvers while rejecting disturbances and meet the established requirements. Finally, through the analysis of pointing error, it is concluded that nonlinear control techniques are a viable and alternative option to the typically used controllers.},
	author = {G., Ernesto D. Cort{\'e}s and Rosero, Esteban and P., German W. Rodriguez},
	booktitle = {2023 IEEE 6th Colombian Conference on Automatic Control (CCAC)},
	date-added = {2025-04-17 18:36:21 -0600},
	date-modified = {2025-04-17 18:36:21 -0600},
	doi = {10.1109/CCAC58200.2023.10333817},
	keywords = {Earth;Satellites;Attitude control;Process control;Kinematics;Position measurement;Kinetic theory;CubeSat Mission;ADCS;Lyapunov;Non-Linear Controller;PD Controller;Sliding Mode Controller;MRP},
	pages = {1-6},
	title = {Non-Linear Control Strategies for Attitude Maneuvers of a LEO CubeSat based on Modified Rodrigues Parameters},
	year = {2023},
	bdsk-url-1 = {https://doi.org/10.1109/CCAC58200.2023.10333817}}

