	abstract = {A functional and mathematical description of the ground station alert predictor is presented. The alert predictor generates the times during which a satellite will be visible to a ground tracking station and provides ground antenna pointing information. The methods used to generate this information are computationally quite efficient so that long-term predictions can be done rapidly. Several new innovations are included in the algorithms: the effects of atmospheric drag upon satellites are taken into account, and a satellite orbit adjust may be included during the prediction interval.},
	author = {Parks, A. D.},
	date-added = {2025-04-17 18:36:21 -0600},
