@misc{nga_tspi_2012,
	abstract = {Time-Space-Position Information (TSPI) includes the specification of the spatial, temporal, and accompanying quality assessment characteristics of entities (e.g., equipment, combatants, and targets). This specification is central to Geospatial Intelligence (GEOINT), the National System for Geospatial Intelligence (NSG), and missions throughout the Department of Defense (DoD) and Intelligence Community (IC). It includes spatial information (position, extent, size, orientation, etc.), temporal information (position, duration, and periodic recurrence), and a robust spatial and temporal reference system.},
	author = {Geospatial Intelligence Standards Working Group (GWG) Application Schemas and Metadata (ASM) Focus Group},
