





@article{doi:10.1137/S1064827598334666,
author = {Jurgens, H. M. and Zingg, D. W.},
title = {Numerical Solution of the Time-Domain Maxwell Equations Using High-Accuracy Finite-Difference Methods},
journal = {SIAM Journal on Scientific Computing},
volume = {22},
