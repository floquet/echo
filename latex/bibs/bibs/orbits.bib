@book{wolaver1970modern,
	abstract = {This report represents lecture notes for a graduate level course in celestial mechanics which
has been given at the Air Force Institute of Technology. It covers a review of the two-body
problem, discusses the three-body problem, the restricted three-body problem together with
regularization and stability analysis. The main portion of the report develops the Hamilton-
Jacobi theory and applies it to develop Lagrange's and Gauss' planetary equations. The
oblate earth potential is developed and the secular equation solved. },
