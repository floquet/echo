@article{PhysRevA.64.032110,
	abstract = {The coherent states for the quantum Kepler motion proposed in our previous work [Phys. Rev. A 59, 1021 (1999)], which is based on the dynamical $SU⁡(2) \otimes SU⁡(2)$ symmetry and the Duru-Kleinert auxiliary time, are improved by making use of the theory of the conserved-charge coherent states formulated by Bhaumik et al. and by Skagertsam. The expectation values for the angular momentum and the Runge-Lenz-Pauli vector with respect to the improved Kepler coherent states are also discussed.},
