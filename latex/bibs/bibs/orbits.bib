@techreport{price1968derivation,
	abstract = {The desirability of obtaining simplified and accurate relative equations of motion for two-
impulse rendezvous application resulted in the examination of the Clohessy and Wiltshire
type of simplified equation. An analysis of these equations revealed that large errors were
possible if the radial separation of the two vehicles was large. In an effort to develop more
accurate equations for rendezvous, the apparent erroneous terms were replaced by exact
terms. },
