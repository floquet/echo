	keywords = {Dynamic Model Expansion, Earth Gravitational Perturbation, Goddard Mission Analysis Tool, GMAT, Hamiltonian Methods, LEO Orbits, Lunar-solar Perturbations, Methodology Evaluation, 3-axis Stabilized Satellites},
