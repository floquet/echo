@article{raposo2017efficient,
	abstract = {A new approach for solving Kepler equation for elliptical orbits is developed in this paper. This
new approach takes advantage of the very good behaviour of the modified Newton--Raphson
method when the initial seed is close to the looked for solution. To determine a good initial
seed the eccentric anomaly domain $[0, \pi]$ is discretized in several intervals and for each one
of these intervals a fifth degree interpolating polynomial is introduced. The six coefficients
of the polynomial are obtained by requiring six conditions at both ends of the corresponding
interval. Thus the real function and the polynomial have equal values at both ends of the
interval. Similarly relations are imposed for the two first derivatives. In the singular corner
of the Kepler equation, $M  \ll 1$ and $1 − e  \ll 0$ an asymptotic expansion is developed. In
most of the cases, the seed generated leads to reach machine error accuracy with the modified
Newton--Raphson method with no iterations or just one iteration. This approach improves the
computational time compared with other methods currently in use.},
	author = {Raposo-Pulido, Virginia and Pel{\'a}ez, J},
	date-added = {2025-04-19 20:32:16 -0600},
	date-modified = {2025-04-19 21:18:01 -0600},
	doi = {10.1093/mnras/stx138},
	journal = {Monthly Notices of the Royal Astronomical Society},
	number = {2},
	pages = {1702--1713},
	publisher = {Oxford University Press},
	title = {An efficient code to solve the Kepler equation. Elliptic case},
	url = {https://academic.oup.com/mnras/article/467/2/1702/2929272},
	volume = {467},
	year = {2017},
	bdsk-url-1 = {https://academic.oup.com/mnras/article/467/2/1702/2929272},
	bdsk-url-2 = {https://doi.org/10.1093/mnras/stx138}}

@article{raposo2018efficient,
	abstract = {This paper introduces a new approach for solving the Kepler equation 
             for hyperbolic orbits through the Hyperbolic Kepler Equation--Space 
             Dynamics Group (HKE--SDG) code. Rather than developing new algorithms, 
             we substantially improve classic Newton--Raphson schemes by optimizing 
             the initial seed selection. For discretized domains of hyperbolic anomaly, 
             we implement fifth-degree interpolating polynomials (with asymptotic 
             expansion for the final interval) whose six coefficients are determined 
             by matching function values and first derivatives at interval endpoints. 
             A specialized asymptotic expansion handles the singular corner ($|M| < 0.15$, 
             $1 < e < 1.25$). Numerical simulations demonstrate machine-error accuracy 
             within maximum three iterations (99.8\% cases $\leq$2 iterations) across 
             double/quadruple precision implementations. The HKE--SDG algorithm achieves 
             superior precision (0.3s execution in double precision) while maintaining 
             reliability, particularly in the singular corner where a single asymptotic 
             expansion suffices. Comparative analysis confirms its precision advantage 
             over existing methods in both precision regimes.},
	author = {Raposo-Pulido, V and Pel{\'a}ez, J},
	date-added = {2025-04-19 20:24:44 -0600},
	date-modified = {2025-04-19 20:30:12 -0600},
	journal = {Astronomy \& Astrophysics},
	pages = {A129},
	publisher = {EDP Sciences},
	title = {An efficient code to solve the Kepler equation-Hyperbolic case},
	url = {https://www.aanda.org/articles/aa/pdf/2018/11/aa33563-18.pdf},
	volume = {619},
	year = {2018},
	bdsk-url-1 = {https://www.aanda.org/articles/aa/pdf/2018/11/aa33563-18.pdf}}

@article{odell1986procedures,
	abstract = {We review starting formulae and iteration processes for the solution of Kepler's equation, and give details of two complete procedures. The first has been in use for a number of years, but the second is entirely new. The new procedure operates with an iterative process that always gives fourth-order convergence and is taken to only two iterations. The error in the resulting solution then never exceeds $7\times10^{−15} I $ rad.},
	author = {Odell, AW and Gooding, RH},
	date-added = {2025-04-19 20:09:38 -0600},
