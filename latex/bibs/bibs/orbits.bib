@article{asano2021stability,
	abstract = {The stability of spacecraft motion in the vicinity of a second body in the elliptic restricted three-body problem (ER3BP) is discussed. This problem is approximated as the Tschauner-Hempel problem perturbed by the gravitational force of the second body (Tschauner-Hempel three-body problem, TH3BP). Under the condition that the eccentricity is small enough, an orbital stability analysis is performed with the initial in-plane amplitude and out-of-plane amplitude of the spacecraft as two parameters. The system's unstable regions in the parameter plane are classified into three patterns: the first instability is caused by the average motion, the second is caused by the non-average motion, and the third is caused by the difference between the periods of the in-plane and out-of-plane motion. These mechanisms and the parameter conditions of orbit instability in each region are analyzed.},
	author = {Asano, Yuta and Satoh, Satoshi and Yamada, Katsuhiko},
	date-added = {2025-04-02 18:21:17 -0600},
	date-modified = {2025-04-02 18:21:54 -0600},
