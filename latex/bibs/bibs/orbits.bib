	issn = {2229-8649},
	journal = {International Journal of Automotive and Mechanical Engineering (IJAME)},
	keywords = {Orbital Mechanics, Gravitational Potential, Spacecraft Formation Flying},
	month = {January--June},
	pages = {1802--1819},
	publisher = {Universiti Malaysia Pahang},
	title = {Influence of the Earth's Dominant Oblateness Parameter on the Low Formation Orbits of Micro-Satellites},
	url = {https://ijame.umpsa.edu.my/images/Volume_9/28_Djojodihardjo.pdf},
	volume = {9},
	year = {2014},
	bdsk-url-1 = {https://ijame.umpsa.edu.my/images/Volume_9/28_Djojodihardjo.pdf},
	bdsk-url-2 = {https://doi.org/10.15282/ijame.9.2013.28.0150}}

@article{baloch2024satellite,
	abstract = {A rendezvous is a set of orbital maneuvers applied to a spacecraft which arrives at a very close distance to the orbit of another
satellite. This paper explores a method to help simplify deriving the rendezvous scheme for satellites. Potential applications of
this project include utilizing satellite rendezvous design for service missions, space supply and space debris cleaning. Satellite
rendezvous is crucial for various space missions but presents challenges due to complex orbital dynamics. This paper proposes a
novel scheme that combines the strengths of Clohessy Wiltshire (CW) equations and Hohmann transfers for more efficient and
precise rendezvous. The CW equations will provide the mathematical framework for relative motion between two orbiting bodies,
which makes them instrumental in predicting and planning the movements required for a successful rendezvous. By incorporating
these equations, the proposed scheme can accurately model the relative trajectories of the satellites. Meanwhile, the Hohmann
transfer, known for its fuel efficiency in moving between circular orbits, is employed to adjust the spacecraft's orbit to align closely
with the target satellite. Combining these methodologies allows for a rendezvous approach that minimizes fuel consumption
while maintaining high precision. This integrated approach is particularly beneficial for missions involving multiple rendezvous
operations or those requiring frequent orbital adjustments, such as servicing satellites, refuelling missions, and actively removing
space debris. The efficiency gained from this method can lead to significant cost savings and enhanced mission capabilities.
Additionally, the simplified derivation process proposed in this paper can make the planning and execution of satellite rendezvous
more accessible to a broader range of missions, potentially expanding the scope of satellite operations in low Earth orbit and
beyond.},
	author = {Baloch, Raaid Ahmed},
	date-added = {2025-05-27 19:45:29 -0600},
	date-modified = {2025-05-27 19:46:10 -0600},
	title = {Satellite Rendezvous Scheme},
	url = {https://nhsjs.com/wp-content/uploads/2024/08/Satellite-Rendezvous-Scheme.pdf},
	year = {2024},
	bdsk-url-1 = {https://nhsjs.com/wp-content/uploads/2024/08/Satellite-Rendezvous-Scheme.pdf}}

