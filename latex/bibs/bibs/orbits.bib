@article{PhysRevD.29.326,
	abstract = {In the relativistic Kepler problem the analytic continuation of the principal quantum number $n$ into $I\nu$ describes the scattering states. When $\nu^{2}$ ranges from $+\infty$ to $\alpha^{2}$ the energy ranges from $(m_{1}+m_{2})$ to infinity. In the remaining gap $0 < \nu^{2} < \alpha^{2}$, the energy becomes complex corresponding to a continuum of resonances or perhaps pair production. This phenomenon also exists in the classical relativistic problem, and we suggest that one should look experimentally for the manifestation of this gap, for example when $Z> \sim 137$.},
