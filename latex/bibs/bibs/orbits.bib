@article{basilio2025charged,
	abstract = {Lie--Poisson electrodynamics describes the semi-classical limit of non-commutative $U (1)$ gauge theory, characterized by Lie-algebra-type non-commutativity. We focus on the mechanics of a charged point-like particle moving in a given gauge background. First, we derive explicit expressions for gauge-invariant variables representing the particle's position. Second, we provide a detailed formulation of the classical action and the corresponding equations of motion, which recover standard relativistic dynamics in the commutative limit. We illustrate our findings by exploring the exactly solvable Kepler problem in the context of the $\lambda-$Minkowski (or the angular) non-commutativity, along with other examples.},
	author = {Basilio, BS and Kupriyanov, VG and Kurkov, MA},
