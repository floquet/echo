	keywords = {Formation flying, Elliptic orbit, Station-keeping, Hamiltonian structure-preserving control, Floquet theory},
	pages = {105508},
	title = {Application of Floquet theory to formation flying in elliptic orbits via a Hamiltonian structure-preserving control},
