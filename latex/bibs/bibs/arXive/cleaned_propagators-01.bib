@article{swenson2017application,
	abstract = {A novel application of Modified Chebyshev Picard Iteration (MCPI) to differential correction is presented. By leveraging the Chebyshev basis functions of MCPI, interpolation in 1 dimension may be used to target plane crossing events, instead of integrating the 42 dimensional variational equation required for standard step integrators. This results in dramatically improved performance over traditional differential correctors. MCPI was tested against the Runge-Kutta 7/8 integrator on over 45,000 halo orbits in three different three-body problems, and was found to be up to an order of magnitude faster, while simultaneously increasing robustness.},
	author = {Swenson, Travis and Woollands, Robyn and Junkins, John and Lo, Martin},
	date-added = {2025-04-10 16:12:14 -0600},
	date-modified = {2025-04-10 16:12:28 -0600},
