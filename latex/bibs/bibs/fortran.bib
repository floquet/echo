@inproceedings{veldhuizen1997will,
	abstract = {As of 1994, the performance of C++ for scientific computing was disappointing. Typical benchmarks showed C++ lagging behind Fortran's performance by 20\% to a factor of ten. Performance was so poor that mixed-language programming was necessary: a program's framework could be written in C++, but any speed-critical routines had to be coded in Fortran. 

In the past five years there have been significant developments. There are now C++ compilers which perform C++-specific optimizations, such as KAI C++ (from Kuck and Associates Inc.) and Intel C++. Two new programming techniques---expression templates and template metaprograms---perform optimizations such as loop fusion and algorithm specialization. Recent benchmarks show C++ encroaching steadily on Fortran's high-performance monopoly. The latest results are so encouraging that we can pose a heretical question: Will C++ be faster than Fortran?

We start by looking at reasons why C++ used to be slower, and then describe techniques which can make it faster than Fortran. Ideas are illustrated with examples and benchmarks from the Blitz++ class library..},
	author = {Veldhuizen, Todd L and Jernigan, M Ed},
	booktitle = {International Conference on Computing in Object-Oriented Parallel Environments},
	date-added = {2025-03-11 12:19:05 -0600},
	date-modified = {2025-03-11 12:21:13 -0600},
	organization = {Springer},
	pages = {49--56},
	title = {Will C++ be faster than Fortran?},
	year = {1997}}

