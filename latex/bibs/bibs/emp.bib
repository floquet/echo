	issn = {2333-5084},
	journal = {Earth and Space Science},
	keywords = {nuclear explosion, earth-surface impedance, electromagnetic induction, electromagnetic pulse, hazards, space weather},
	language = {en},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1029/2021EA001792},
	number = {8},
	pages = {e2021EA001792},
	shorttitle = {Down to {Earth} {With} {Nuclear} {Electromagnetic} {Pulse}},
	title = {Down to {Earth} {With} {Nuclear} {Electromagnetic} {Pulse}: {Realistic} {Surface} {Impedance} {Affects} {Mapping} of the {E3} {Geoelectric} {Hazard}},
