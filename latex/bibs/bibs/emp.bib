	journal = {International Journal of Modern Physics B},
	language = {en},
	month = oct,
	number = {20},
	pages = {3353--3380},
	title = {{NUCLEAR} {MAGNETOHYDRODYNAMIC} {EMP}, {SOLAR} {STORMS}, {AND} {SUBSTORMS}},
	url = {https://www.worldscientific.com/doi/abs/10.1142/S0217979292001481},
	urldate = {2022-10-27},
	volume = {06},
