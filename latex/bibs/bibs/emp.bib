	file = {IEEE Xplore Abstract Record:/Users/dantopa/Zotero/storage/B5ZXAY7Q/8250852.html:text/html;IEEE Xplore Full Text PDF:/Users/dantopa/Zotero/storage/V8YHLFV5/Zang and Zhang - 2017 - Simulation of the high-altitude nuclear EMP by usi.pdf:application/pdf},
	keywords = {Explosions, Electromagnetics, EM analysis, Analytical models, Numerical models, Electromagnetic compatibility, electromagnetic compatibility (EMC), high-altitude nuclear pulse (HEMP), nuclear explosion, numerical simulation, Numerical simulation},
	month = oct,
