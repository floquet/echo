@article{ritson1987xraylaser,
	abstract = {It is argued that the nuclear-explosion-pumped X-ray laser, one component of SDI, is technically feasible. A 120-kT fission bomb is exploded near a bundle of properly shaped and oriented zinc wires, releasing narrow beams of laser X-rays at targets. The effect depends on physically intercepting the radiation from the explosion, keeping a larger proportion of it in the form of X-rays, and directing it in predetermined directions. The relevant parameters of the weapon are listed, and the choice of parameters and the basis of the estimates of potential performance are discussed.},
	author = {D. M. Ritson},
