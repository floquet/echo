	issn = {1558-1578},
	journal = {IEEE Transactions on Nuclear Science},
	keywords = {Mathematical model, EMP radiation effects, nuclear explosions, Photonics, Atmospheric modeling, Conductivity, Electromagnetics, EM analysis, high-altitude electromagnetic pulse (HEMP), Monte Carlo methods, radiative interference, Scattering},
	month = apr,
