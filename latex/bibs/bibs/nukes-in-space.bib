	journal = {IEEE Transactions on Electromagnetic Compatibility},
	keywords = {Earth, Electromagnetic pulse (EMP), high altitude electromagnetic pulses (HEMP), HPEM, IEC Standards, Impedance, Polarization, pulse current injection (PCI) testing, Short-circuit currents, Soil},
	month = feb,
